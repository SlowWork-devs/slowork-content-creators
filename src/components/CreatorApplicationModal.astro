---
import { LoaderCircle, X } from '@lucide/astro';

import type { CreatorApplicationModalCopy } from '../models/creator-application-modal.copy';
import { MAIN_SLOWORK_ORIGIN } from '../constants/site';

import '../styles/creator-application-modal.css';

interface Props {
  lang: 'en' | 'es';
  copy: CreatorApplicationModalCopy;
}

const { lang, copy } = Astro.props;

const termsUrl = `${MAIN_SLOWORK_ORIGIN}/${lang}/terms-and-conditions/`;
const privacyUrl = `${MAIN_SLOWORK_ORIGIN}/${lang}/privacy-policy/`;

const fieldClass =
  'w-full rounded-xl border border-primary/20 bg-white/50 px-4 py-3 text-sm text-[#013333] shadow-sm outline-none transition placeholder:text-primary/40 focus:border-secondary focus:ring-2 focus:ring-secondary/40';
const labelClass = 'mb-1.5 block text-left text-xs font-bold uppercase tracking-widest text-primary/75';
const checkClass =
  'checkbox checkbox-sm shrink-0 border-primary/25 [--chkfg:var(--color-secondary-content)] [--chkbg:var(--color-secondary)]';
---

<script
  type="application/json"
  id="creator-application-json"
  data-lang={lang}
  set:html={JSON.stringify(copy)}
/>

<dialog
  id="creator-application-dialog"
  class="creator-application-dialog flex items-center justify-center p-4 outline-none"
  aria-labelledby="creator-application-title"
  data-phase="idle"
>
  <div class="creator-application-panel">
    <div
      class="flex shrink-0 items-start justify-between gap-4 border-b border-primary/10 px-6 py-4"
    >
      <div class="min-w-0 text-left">
        <h2 id="creator-application-title" class="text-lg font-bold tracking-tight md:text-xl">
          {copy.dialogTitle}
        </h2>
        <p id="creator-application-step-label" class="mt-1 text-sm text-primary/70">
          {copy.stepOf.replace('{current}', '1').replace('{total}', '4')}
        </p>
      </div>
      <button
        type="button"
        class="creator-application-close btn btn-circle btn-ghost btn-sm shrink-0 text-primary"
        aria-label={copy.closeAria}
        data-creator-application-close
      >
        <X size={20} stroke-width={2} aria-hidden="true" />
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-y-contain px-6 py-5">
      <p
        id="creator-application-status"
        class="mb-4 hidden rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm text-error"
        role="alert"
        data-status="idle"
      />

      <div id="thank-you-screen" class="creator-application-thank-you text-center" data-visible="false">
        <h3 class="text-xl font-bold tracking-tight">{copy.thankYouTitle}</h3>
        <p class="mt-3 text-sm leading-relaxed text-primary/80">{copy.thankYouLead}</p>
        <div
          class="mt-6 flex flex-col items-center justify-center gap-3 text-sm font-medium text-primary"
          aria-live="polite"
        >
          <LoaderCircle
            size={28}
            stroke-width={2}
            class="animate-spin text-secondary"
            aria-hidden="true"
          />
          <p>{copy.redirecting}</p>
        </div>
      </div>

      <div id="creator-application-form-wrap" class="creator-application-form-wrap" data-visible="true">
        <form id="creator-application-form" class="space-y-0" novalidate>
          <fieldset class="creator-application-fieldset space-y-4" data-step="1" data-active="true">
            <div>
              <label class={labelClass} for="ca-name">{copy.fieldName}</label>
              <input
                id="ca-name"
                name="name"
                type="text"
                autocomplete="given-name"
                class={fieldClass}
                maxlength="120"
                required
              />
            </div>
            <div>
              <label class={labelClass} for="ca-surname">{copy.fieldSurname}</label>
              <input
                id="ca-surname"
                name="surname"
                type="text"
                autocomplete="family-name"
                class={fieldClass}
                maxlength="120"
                required
              />
            </div>
            <div>
              <label class={labelClass} for="ca-email">{copy.fieldEmail}</label>
              <input
                id="ca-email"
                name="email"
                type="email"
                autocomplete="email"
                class={fieldClass}
                maxlength="254"
                required
              />
            </div>
            <div>
              <label class={labelClass} for="ca-country">{copy.fieldCountry}</label>
              <input id="ca-country" name="countryOfResidence" type="text" class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="ca-lang">{copy.fieldMainLanguage}</label>
              <input id="ca-lang" name="mainLanguage" type="text" class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="ca-phone">{copy.fieldPhone}</label>
              <input
                id="ca-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class={fieldClass}
              />
            </div>
            <div>
              <label class={labelClass} for="ca-travel">{copy.fieldUsualTravel}</label>
              <input id="ca-travel" name="usualTravelLocation" type="text" class={fieldClass} />
            </div>
          </fieldset>

          <fieldset class="creator-application-fieldset space-y-4" data-step="2" data-active="false">
            <div>
              <label class={labelClass} for="ca-nickname">{copy.fieldNickname}</label>
              <input id="ca-nickname" name="nickname" type="text" class={fieldClass} />
            </div>
            <div>
              <span class={labelClass}>{copy.fieldPlatforms}</span>
              <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {
                  (
                    [
                      ['instagram', copy.platformInstagram],
                      ['tiktok', copy.platformTiktok],
                      ['youtube', copy.platformYoutube],
                      ['linkedin', copy.platformLinkedin],
                      ['other', copy.platformOther],
                    ] as const
                  ).map(([value, label]) => (
                    <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-primary/15 bg-white/40 px-3 py-2 text-sm">
                      <input type="checkbox" name="platforms" value={value} class={checkClass} />
                      <span>{label}</span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div>
              <label class={labelClass} for="ca-profiles">{copy.fieldProfileUrls}</label>
              <textarea
                id="ca-profiles"
                name="profileUrls"
                class:list={[fieldClass, 'min-h-[88px] resize-y']}
                rows={3}
              />
            </div>
            <div>
              <label class={labelClass} for="ca-niche">{copy.fieldMainNiche}</label>
              <select id="ca-niche" name="mainNiche" class={fieldClass}>
                <option value="">—</option>
                <option value="travel">{copy.nicheTravel}</option>
                <option value="lifestyle">{copy.nicheLifestyle}</option>
                <option value="remote_work">{copy.nicheRemoteWork}</option>
                <option value="digital_nomad">{copy.nicheDigitalNomad}</option>
                <option value="wellbeing">{copy.nicheWellbeing}</option>
                <option value="intentional_living">{copy.nicheIntentional}</option>
                <option value="other">{copy.nicheOther}</option>
              </select>
            </div>
            <div>
              <label class={labelClass} for="ca-regions">{copy.fieldContentRegions}</label>
              <input id="ca-regions" name="contentRegions" type="text" class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="ca-content-lang">{copy.fieldContentLanguage}</label>
              <input id="ca-content-lang" name="contentLanguage" type="text" class={fieldClass} />
            </div>
            <div>
              <span class={labelClass}>{copy.fieldEnglishCapability}</span>
              <div class="mt-2 flex gap-4">
                <label class="flex cursor-pointer items-center gap-2 text-sm">
                  <input type="radio" name="englishCapability" value="yes" class="radio radio-sm" />
                  {copy.yes}
                </label>
                <label class="flex cursor-pointer items-center gap-2 text-sm">
                  <input type="radio" name="englishCapability" value="no" class="radio radio-sm" />
                  {copy.no}
                </label>
              </div>
            </div>
          </fieldset>

          <fieldset class="creator-application-fieldset space-y-4" data-step="3" data-active="false">
            <div>
              <label class={labelClass} for="ca-post1">{copy.fieldPost1}</label>
              <input id="ca-post1" name="postLink1" type="url" class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="ca-post2">{copy.fieldPost2}</label>
              <input id="ca-post2" name="postLink2" type="url" class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="ca-post3">{copy.fieldPost3}</label>
              <input id="ca-post3" name="postLink3" type="url" class={fieldClass} />
            </div>
            <div>
              <label class={labelClass} for="ca-why">{copy.fieldWhyJoin}</label>
              <textarea
                id="ca-why"
                name="whyJoin"
                class:list={[fieldClass, 'min-h-[140px] resize-y leading-relaxed']}
                rows={5}
                required
                minlength={30}
              />
            </div>
            <div>
              <span class={labelClass}>{copy.fieldAvailability}</span>
              <div class="mt-2 flex gap-4">
                <label class="flex cursor-pointer items-center gap-2 text-sm">
                  <input type="radio" name="availabilityToVisit" value="yes" class="radio radio-sm" />
                  {copy.yes}
                </label>
                <label class="flex cursor-pointer items-center gap-2 text-sm">
                  <input type="radio" name="availabilityToVisit" value="no" class="radio radio-sm" />
                  {copy.no}
                </label>
              </div>
            </div>
            <div>
              <span class={labelClass}>{copy.fieldWillingnessPhases}</span>
              <div class="mt-2 flex gap-4">
                <label class="flex cursor-pointer items-center gap-2 text-sm">
                  <input
                    type="radio"
                    name="willingnessCreatePhases"
                    value="yes"
                    class="radio radio-sm"
                  />
                  {copy.yes}
                </label>
                <label class="flex cursor-pointer items-center gap-2 text-sm">
                  <input
                    type="radio"
                    name="willingnessCreatePhases"
                    value="no"
                    class="radio radio-sm"
                  />
                  {copy.no}
                </label>
              </div>
            </div>
            <div>
              <label class={labelClass} for="ca-living">{copy.fieldLivingDifferently}</label>
              <textarea
                id="ca-living"
                name="livingDifferently"
                class:list={[fieldClass, 'min-h-[120px] resize-y leading-relaxed']}
                rows={4}
              />
            </div>
          </fieldset>

          <fieldset class="creator-application-fieldset space-y-4" data-step="4" data-active="false">
            <div class="space-y-3 rounded-2xl border border-primary/10 bg-white/40 px-4 py-4 text-sm">
              <label class="flex cursor-pointer items-start gap-3">
                <input
                  type="checkbox"
                  name="dobAgeConfirmed"
                  value="yes"
                  class={checkClass}
                  required
                />
                <span>{copy.fieldDobConfirm}</span>
              </label>
              <label class="flex cursor-pointer items-start gap-3">
                <input
                  type="checkbox"
                  name="agreeTerms"
                  value="yes"
                  class={checkClass}
                  required
                />
                <span>
                  {copy.agreeTermsPrefix}
                  <a
                    href={termsUrl}
                    class="font-semibold underline decoration-secondary/80 underline-offset-2"
                    target="_blank"
                    rel="noopener noreferrer">{copy.agreeTermsLink}</a>
                </span>
              </label>
              <label class="flex cursor-pointer items-start gap-3">
                <input
                  type="checkbox"
                  name="agreePrivacy"
                  value="yes"
                  class={checkClass}
                  required
                />
                <span>
                  {copy.agreePrivacyPrefix}
                  <a
                    href={privacyUrl}
                    class="font-semibold underline decoration-secondary/80 underline-offset-2"
                    target="_blank"
                    rel="noopener noreferrer">{copy.agreePrivacyLink}</a>
                </span>
              </label>
            </div>
          </fieldset>
        </form>
      </div>
    </div>

    <div
      class="flex shrink-0 flex-col-reverse gap-3 border-t border-primary/10 px-6 py-4 sm:flex-row sm:justify-between"
      id="creator-application-actions"
      data-visible="true"
    >
      <button
        type="button"
        id="creator-application-back"
        class="btn btn-ghost rounded-full text-primary"
        disabled
      >
        {copy.back}
      </button>
      <div class="flex flex-col gap-3 sm:flex-row-reverse">
        <button
          type="button"
          id="creator-application-next"
          class="btn rounded-full border-0 bg-secondary font-bold uppercase tracking-widest text-secondary-content hover:bg-secondary/90"
        >
          {copy.next}
        </button>
        <button
          type="submit"
          form="creator-application-form"
          id="creator-application-submit"
          class="btn hidden gap-2 rounded-full border-0 bg-secondary font-bold uppercase tracking-widest text-secondary-content hover:bg-secondary/90"
          data-status="idle"
        >
          <LoaderCircle
            size={16}
            stroke-width={2}
            class="hidden animate-spin"
            data-creator-application-spinner
            aria-hidden="true"
          />
          <span id="creator-application-submit-label">{copy.submit}</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { mountCreatorApplicationModal } from '../utils/creator-application-modal.mount';
  mountCreatorApplicationModal();
</script>
